<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" >
<head id="Head1" runat="server">
    <meta content="text/html; charset=utf-8" http-equiv="Content-Type" />
    <meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1"/>
    <meta name="Author" content="Asher Solutions Online"/>
    <meta name="GENERATOR" content="Mozilla/4.79 [en] (Windows NT 5.0; U) [Netscape]"/>
    <meta name="keywords" content="pre need funeral, Pre-need funeral, pre need funeral insurance, pre need funeral planning, pre-need funeral arrangements, preneed funeral, Funeral services, funeral arrangements, funeral programs, funeral costs, funeral ceremony, cost of a funeral, Funeral information, Funeral Guide, funeral article, modern funeral, funeral procedures, funeral process, Veteran funeral, Veterans funerals, Veterans funeral, Veterans burial benefits, Veteran Cemetary, Veterans Cemetary" />
    <meta name="description" content="Preneed funeral plans outline wishes for funeral services and interment. To avoid inflationary costs, prepaid funeral plans are available." />
    <title>The Veteran Program</title>
    <link id="Link1" runat="server" rel="shortcut icon" href="~/favicon.ico" type="image/x-icon"/>
    <link id="Link2" runat="server" rel="icon" href="~/favicon.ico" type="image/ico"/>
    <link href="~/styles/style2.css" media="screen" rel="stylesheet" title="CSS" type="text/css" />

    <!-- Ensure masthead background image from style2.css displays correctly (no-repeat, centered, scaled) -->
    <style type="text/css">
        /* Override and harden masthead background behavior so updated URL in style2.css is honoured */
        #masthead {
            background-repeat: no-repeat !important;
            background-position: center top !important;
            background-size: cover !important;
        }

        /* Small tweak so text sits correctly over background */
        .masthead-text { max-width: 75%; margin-left: auto; }

        /* PLMS navigation: split into two evenly spaced rows */
        #plms-links {
            display: flex;
            flex-direction: column;
            gap: 8px;
            align-items: stretch;
        }

        .plms-row {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: flex-start;
        }

        /* Make the 8 buttons per row size evenly.
           Using flex-basis calc for 8 columns (100% / 8 = 12.5%). Subtract gap roughly. */
        .plms-row .plms-btn {
            flex: 1 1 calc(12.5% - 8px);
            max-width: calc(12.5% - 8px);
            box-sizing: border-box;
        }

        /* Responsive tweak: on small screens let buttons wrap naturally */
        @media (max-width: 900px) {
            .plms-row .plms-btn {
                flex: 1 1 25%;
                max-width: 25%;
            }
        }
        @media (max-width: 600px) {
            .plms-row .plms-btn {
                flex: 1 1 50%;
                max-width: 50%;
            }
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Begin Container -->
        <div id="container">
	        <!-- Begin Masthead -->
	        <div id="masthead">
		        <div class="masthead-text">
                    <p class="masthead-title"><strong>The Veteran Program</strong></p>
                    <p class="masthead-sub">"Together Meeting Your Needs"</p>
                    <h1 style="visibility: hidden">Planning a funeral in advance of death is called pre need funeral planning. Pre need funeral plans outline wishes for funeral services and interment. To avoid inflationary funeral costs, prepaid funeral plans are available.</h1>
                </div>
	        </div>
	        <!-- End Masthead -->

	        <!-- Navigation toolbar: PLMS buttons -->
	        <div id="navigationmast">
                <div id="plms-links">
                    <div class="plms-row">
                        <asp:Button ID="btnCustomer" runat="server" CssClass="plms-btn" Text="Customer Lookup (No Filters)" CommandArgument="~/customer.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btnInputForm" runat="server" CssClass="plms-btn" Text="New Lead Input" CommandArgument="~/inputform.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btnLookupLNH" runat="server" CssClass="plms-btn" Text="Lookup By Lst Name/Phone" CommandArgument="~/custlookuplnhp.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btnLookupHP" runat="server" CssClass="plms-btn" Text="Lookup By Phone" CommandArgument="~/custlookuphp.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btnLookupAgent" runat="server" CssClass="plms-btn" Text="Lookup By Agent" CommandArgument="~/custlookupagnt.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btnAgentNew" runat="server" CssClass="plms-btn" Text="New Lead by Agent" CommandArgument="~/cluAgentnew.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btnAgentActive" runat="server" CssClass="plms-btn" Text="Active Lead by Agent" CommandArgument="~/cluAgentActive.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btnCBTickler" runat="server" CssClass="plms-btn" Text="Agent Call Bck Tickler" CommandArgument="~/cluAgentCBTickler.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btnFunHMMaint" runat="server" CssClass="plms-btn" Text="Fun Home Maint" CommandArgument="~/flpreffunhomesmaint.aspx" OnClick="NavigateToPage" />

                    </div>
                    <div class="plms-row">
                        <asp:Button ID="btnAgentCB" runat="server" CssClass="plms-btn" Text="Call Back Lead by Agent" CommandArgument="~/cluAgentCB.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btnLMTickler" runat="server" CssClass="plms-btn" Text="Agent Left Msg Tickler" CommandArgument="~/cluAgentLMTickler.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btnLastResort" runat="server" CssClass="plms-btn" Text="Last Resort Leads" CommandArgument="~/cluLastResort.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btnAgentSold" runat="server" CssClass="plms-btn" Text="Sold By Agent" CommandArgument="~/cluAgentSold.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btnInputSoldLead" runat="server" CssClass="plms-btn" Text="Update Sold Leads" CommandArgument="~/inputsoldlead.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btnMailService" runat="server" CssClass="plms-btn" Text="Leads Needing Mail Service" CommandArgument="~/mailservice.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btnAgentSM" runat="server" CssClass="plms-btn" Text="Sent Mail by Agent" CommandArgument="~/cluAgentSM.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btnAgentWeb" runat="server" CssClass="plms-btn" Text="Website Lead By Agent" CommandArgument="~/cluAgentWeb.aspx" OnClick="NavigateToPage" />
                        <asp:Button ID="btncastketMaint" runat="server" CssClass="plms-btn" Text="Casket Price Maint" CommandArgument="~/casketrsmaint.aspx" OnClick="NavigateToPage" />
                    </div>
                </div>
	        </div>

        </div>

        <!-- Main content placeholders (pages inject their content here) -->
        <asp:ContentPlaceHolder ID="MainContent1" runat="server" />
        <asp:ContentPlaceHolder ID="MainContent2" runat="server" />        		

    	<!-- Begin Footer -->
    	<div id="footer">
    		<p>
                <a runat="server" href="~/default.aspx">Home</a> | 
    		    <a runat="server" href="~/about.aspx">About Us</a> | 
    		    <a runat="server" href="~/testimonals/testimonials.aspx">Testimonials</a> |
    		    <a runat="server" href="~/contactus.aspx">Contact Us</a> |
    		    <a runat="server" href="~/benefits/benefits.aspx">Benefits</a> |
    		    <a runat="server" href="~/cemeteries/cemeteries.aspx">National Cemeteries</a> | 
    			<br />The Veteran Program is not affiliated with the U.S. Department of Veteran Affairs. Copyright � 2026 Asher Solutions - All Rights Reserved. Web Desgn and SEO - <a href="http://creativeteksolutions.com">Creative Tech Solutions</a>
            </p>
    	</div>
    	<!-- End Footer -->
    </form>
</body>
</html>
