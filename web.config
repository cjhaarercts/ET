            during development.
        -->
    <compilation debug="true" targetFramework="4.0" />
    <!--
            The <authentication> section enables configuration 
            of the security authentication mode used by 
            ASP.NET to identify an incoming user. 

    <authentication mode="Forms">
      <forms slidingExpiration="true" timeout="60"/>
    </authentication>

    <machineKey decryption="AES" validation="SHA1" decryptionKey="1513F567EE75F7FB5AC0AC4D79E1D9F25430E3E2F1BCDD3370BCFC4EFC97A541" validationKey="32CBA563F26041EE5B5FE9581076C40618DCC1218F5F447634EDE8624508A129"/>
    <membership defaultProvider="salespipelineSqlMembershipProvider">
      <providers>
        Add a customized SqlMembershipProvider
        <add name="salespipelineSqlMembershipProvider" type="System.Web.Security.SqlMembershipProvider" connectionStringName="salespipeline" enablePasswordRetrieval="false" enablePasswordReset="true" requiresQuestionAndAnswer="true" applicationName="SalesPipeline" requiresUniqueEmail="true" passwordFormat="Hashed" maxInvalidPasswordAttempts="5" minRequiredPasswordLength="7" minRequiredNonalphanumericCharacters="1" passwordAttemptWindow="10" passwordStrengthRegularExpression=""/>
      </providers>
    </membership>
    <roleManager enabled="true" defaultProvider="salespipelineSqlRoleProvider" cacheRolesInCookie="true" createPersistentCookie="false" cookieProtection="All">
      <providers>
        <add name="salespipelineSqlRoleProvider" type="System.Web.Security.SqlRoleProvider" applicationName="SalesPipeline" connectionStringName="salespipeline"/>
      </providers>
    </roleManager>
    -->
    <customErrors mode="Off" />
    <pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID" />
    <identity impersonate="false" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <remove value="index.aspx" />
        <add value="index.aspx" />
      </files>
    </defaultDocument>
    <httpErrors errorMode="Detailed" />
  </system.webServer>

  <!-- Update the <smtp> settings -->
  <system.net>
    <mailSettings>
